# Public repo — only the news/ feed + README + LICENSE goes out.
# Everything else (pipeline tooling, intermediate staging, internal docs,
# session handoffs) stays in the local working tree, never committed.

# Ignore everything by default …
/*
/.*

# … then allow only the public-safe surface:
!/news/
!/README.md
!/LICENSE
!/.gitignore
!/docs/
!/scripts/
!/tests/
!/.github/

# Public deterministic contract tooling only. Raw pipeline inputs and local
# approval/session artifacts remain outside this repository.
scripts/*
!scripts/build_news.py
!scripts/purge_jsdelivr.py
tests/*
!tests/test_news_contract.py
!tests/test_jsdelivr_purge.py
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/news-contract.yml
docs/*
!docs/project-history-v1.3.md

# Inside news/, ignore any backups
news/*.bak
news/.tmp_*

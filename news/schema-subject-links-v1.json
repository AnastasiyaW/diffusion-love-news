{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diffusion.love/news/schema-subject-links-v1.json",
  "title": "Diffusion Love public subject links v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "news_id", "subjects", "about", "mentions", "relations"],
  "properties": {
    "schema_version": {"const": "subject-links-v1"},
    "news_id": {"type": "string", "pattern": "^n-[0-9a-f]{10}$"},
    "subjects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject"}},
    "about": {"type": "string", "pattern": "^sgs-[0-9a-f]{32}$"},
    "mentions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sgs-[0-9a-f]{32}$"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_id", "subject_kind", "canonical_name", "identity_url"],
      "properties": {
        "subject_id": {"type": "string", "pattern": "^sgs-[0-9a-f]{32}$"},
        "subject_kind": {"enum": ["company", "project", "model", "version", "tool", "service", "dataset", "method", "technology"]},
        "canonical_name": {"type": "string", "minLength": 1},
        "identity_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["from_subject_id", "relation", "to_subject_id", "evidence_urls"],
      "properties": {
        "from_subject_id": {"type": "string", "pattern": "^sgs-[0-9a-f]{32}$"},
        "relation": {"enum": ["version_of", "derived_from", "compatible_with", "uses", "requires", "owned_by"]},
        "to_subject_id": {"type": "string", "pattern": "^sgs-[0-9a-f]{32}$"},
        "evidence_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diffusion.love/news/schema-v1.3.json",
  "title": "diffusion.love canonical news item",
  "description": "Backward-compatible public item contract for schema versions 1.2 and 1.3.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "entry_type",
    "category",
    "lang",
    "title",
    "summary",
    "research_notes",
    "project",
    "tags",
    "facets",
    "links",
    "evolution",
    "media",
    "source",
    "_meta"
  ],
  "properties": {
    "schema_version": { "enum": ["1.2", "1.3"] },
    "id": { "type": "string", "pattern": "^n-[0-9a-f]{10}$" },
    "entry_type": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "lang": { "const": "en" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "research_notes": { "type": "string" },
    "project": { "$ref": "#/$defs/project" },
    "tags": { "$ref": "#/$defs/stringArray" },
    "facets": { "$ref": "#/$defs/facets" },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resourceLink" }
    },
    "evolution": { "$ref": "#/$defs/evolution" },
    "media": { "$ref": "#/$defs/media" },
    "source": { "$ref": "#/$defs/source" },
    "_meta": { "$ref": "#/$defs/meta" },
    "lifecycle_event": { "$ref": "#/$defs/lifecycleEvent" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "1.2" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["lifecycle_event"] },
            { "required": ["claims"] },
            {
              "properties": {
                "project": {
                  "anyOf": [
                    { "required": ["aliases"] },
                    { "required": ["summary"] },
                    { "required": ["kind"] },
                    { "required": ["status"] },
                    { "required": ["homepage"] },
                    { "required": ["repository"] },
                    { "required": ["domains"] }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "family_slug",
        "family_display",
        "model_slug",
        "model_display",
        "version",
        "released",
        "vendor",
        "vendor_slug",
        "origin_region",
        "license",
        "base_model",
        "adaptation"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/nullableString" },
        "family_slug": {
          "anyOf": [
            { "$ref": "#/$defs/slug" },
            { "type": "null" }
          ]
        },
        "family_display": { "$ref": "#/$defs/nullableString" },
        "model_slug": { "$ref": "#/$defs/nullableString" },
        "model_display": { "$ref": "#/$defs/nullableString" },
        "version": { "$ref": "#/$defs/nullableString" },
        "released": { "$ref": "#/$defs/nullableString" },
        "vendor": { "$ref": "#/$defs/nullableString" },
        "vendor_slug": { "$ref": "#/$defs/nullableString" },
        "origin_region": { "$ref": "#/$defs/nullableString" },
        "license": { "$ref": "#/$defs/nullableString" },
        "base_model": { "$ref": "#/$defs/nullableString" },
        "adaptation": {
          "anyOf": [
            { "$ref": "#/$defs/adaptation" },
            { "type": "null" }
          ]
        },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/slug" },
          "uniqueItems": true
        },
        "summary": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/slug" },
        "status": { "$ref": "#/$defs/slug" },
        "homepage": { "$ref": "#/$defs/httpsUrl" },
        "repository": { "$ref": "#/$defs/httpsUrl" },
        "domains": {
          "type": "array",
          "items": { "$ref": "#/$defs/domainRef" }
        }
      },
      "additionalProperties": false
    },
    "domainRef": {
      "type": "object",
      "required": ["slug", "label", "url"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "label": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpsUrl" }
      },
      "additionalProperties": false
    },
    "adaptation": {
      "type": "object",
      "required": ["type", "purpose", "base_model_slug"],
      "properties": {
        "type": {
          "enum": [
            "lora",
            "controlnet",
            "ip-adapter",
            "dreambooth",
            "textual-inversion",
            "fine-tune",
            "checkpoint-merge",
            "hypernetwork"
          ]
        },
        "purpose": { "$ref": "#/$defs/nullableString" },
        "base_model_slug": { "$ref": "#/$defs/slug" }
      },
      "additionalProperties": false
    },
    "facets": {
      "type": "object",
      "required": [
        "category",
        "entry_type",
        "projects",
        "versions",
        "features",
        "formats",
        "platforms",
        "vendors",
        "base_models",
        "origin",
        "license",
        "year",
        "models",
        "adaptations"
      ],
      "properties": {
        "category": { "type": "string" },
        "entry_type": { "type": "string" },
        "projects": { "$ref": "#/$defs/stringArray" },
        "versions": { "$ref": "#/$defs/stringArray" },
        "features": { "$ref": "#/$defs/stringArray" },
        "formats": { "$ref": "#/$defs/stringArray" },
        "platforms": { "$ref": "#/$defs/stringArray" },
        "vendors": { "$ref": "#/$defs/stringArray" },
        "base_models": { "$ref": "#/$defs/stringArray" },
        "origin": { "$ref": "#/$defs/nullableString" },
        "license": { "$ref": "#/$defs/nullableString" },
        "year": { "type": "integer" },
        "models": { "$ref": "#/$defs/stringArray" },
        "adaptations": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "resourceLink": {
      "type": "object",
      "required": ["kind", "url", "host", "lang", "is_primary", "status", "verified_at"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "host": { "type": "string", "minLength": 1 },
        "lang": { "type": "string", "minLength": 1 },
        "is_primary": { "type": "boolean" },
        "status": { "type": "string", "minLength": 1 },
        "verified_at": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "evolution": {
      "type": "object",
      "required": ["summary", "latest_version", "related_ids", "is_latest_in_family"],
      "properties": {
        "summary": { "$ref": "#/$defs/nullableString" },
        "latest_version": { "$ref": "#/$defs/nullableString" },
        "related_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^n-[0-9a-f]{10}$" },
          "uniqueItems": true
        },
        "is_latest_in_family": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": ["has_image", "has_video"],
      "properties": {
        "has_image": { "type": "boolean" },
        "has_video": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["posted_at", "excerpt"],
      "properties": {
        "posted_at": { "type": "string", "format": "date" },
        "excerpt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": [
        "extracted_at",
        "classified_at",
        "enriched_at",
        "verified_at",
        "models_used",
        "schema_validated"
      ],
      "properties": {
        "extracted_at": { "$ref": "#/$defs/nullableString" },
        "classified_at": { "$ref": "#/$defs/nullableString" },
        "enriched_at": { "$ref": "#/$defs/nullableString" },
        "verified_at": { "$ref": "#/$defs/nullableString" },
        "models_used": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nullableString" }
        },
        "schema_validated": { "const": true }
      },
      "additionalProperties": false
    },
    "lifecycleEvent": {
      "type": "object",
      "required": ["kind", "date", "title"],
      "properties": {
        "kind": { "$ref": "#/$defs/slug" },
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/nullableString" },
        "summary": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["id", "statement", "kind", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "status": { "enum": ["verified", "reported", "inferred"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "title": { "$ref": "#/$defs/nullableString" },
        "publisher": { "$ref": "#/$defs/nullableString" },
        "published_at": {
          "anyOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
